# Colon-separated env files holding secrets (relative to this file or ~); values in this file override them
SECRETS_ENV_FILES=../.env/.streaming-poll-tg-bot.env:~/dev_local/.env
# Or set secrets directly:
TELEGRAM_BOT_TOKEN=
GROQ_API_KEY=
# First-run admins, comma-separated Telegram ids (DM /whoami to the bot). Used only while the DB has no admins;
# after that admins manage the list in the bot: /admins, /addadmin, /removeadmin
ADMIN_USER_IDS=6901813140,188200615
# Groq chat model id, see https://console.groq.com/docs/models
GROQ_SUMMARY_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
# Must be on local disk (SQLite WAL); defaults shown
DB_PATH=~/.local/share/streaming-poll-tg-bot/suggestions.db
#STT_CONCURRENCY=4
#STT_TIMEOUT_S=30
#SUMMARY_TIMEOUT_S=90
#MAX_VOICE_BYTES=19922944
#GROQ_TIMEOUT_S=20
#GROQ_MAX_RETRIES=2
